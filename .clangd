# Use CMake's compile_commands.json (see CMAKE_EXPORT_COMPILE_COMMANDS in CMakeLists.txt).
# Paths are relative to this directory.
CompileFlags:
  CompilationDatabase: build
  # Align with ukengine target flags so clangd does not warn on UTF-8 in comments, etc.
  Add:
    - -Wno-invalid-source-encoding
    - -Wno-narrowing
